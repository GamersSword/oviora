#pragma code_page(65001)
#include <windows.h>
#include "oviora-resource.h"
IDI_OVIORA ICON "oviora.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "ARFEP - IT-Service"
   VALUE "FileDescription", "Oviora"
   VALUE "FileVersion", "@OVIORA_DISPLAY_VERSION@"
   VALUE "ProductName", "Oviora"
   VALUE "ProductVersion", "@OVIORA_DISPLAY_VERSION@"
   VALUE "OriginalFilename", "@OVIORA_RESOURCE_FILENAME@"
   VALUE "LegalCopyright", "© ARFEP IT-Service and the original authors of the video engine. AGPL-3.0 / GPL-3.0."
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
